CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.heltec.csv"
CONFIG_IDF_TARGET="esp32s3"
CONFIG_BOARD_HELTEC_V3=y

# Heltec WiFi LoRa 32 V3: ESP32-S3FN8, 8 MiB DIO flash, no PSRAM.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHMODE="dio"
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_ESPTOOLPY_FLASHFREQ="40m"

# UART0 GPIO43/44 is connected to the CP2102 USB bridge.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# Find My transport uses legacy BLE advertisements through Bluedroid. Wi-Fi
# remains enabled for Cashu mint/TLS operations, so coexistence is required.
# Fresh public namespace for the September 2026 Heltec transmission attempt.
CONFIG_FIND_MY_TRANSPORT_MODEM_ID=0x57A030B3
CONFIG_FIND_MY_TRANSPORT_HEADER_REPEATS=8
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=n
CONFIG_BT_CLASSIC_ENABLED=n
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_BLE_42_ADV_EN=y
# This transport only emits non-connectable raw advertisements. Keep the
# mandatory minimum connection slots but omit unused GATT, pairing and scan
# machinery to preserve internal DRAM for the no-PSRAM wallet and TLS.
CONFIG_BT_ACL_CONNECTIONS=1
CONFIG_BT_MULTI_CONNECTION_ENBALE=n
CONFIG_BT_GATTS_ENABLE=n
CONFIG_BT_GATTC_ENABLE=n
CONFIG_BT_BLE_SMP_ENABLE=n
CONFIG_BT_BLE_42_DTM_TEST_EN=n
CONFIG_BT_BLE_42_SCAN_EN=n
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# Keep the Wi-Fi protocol task on core 0 and the Bluetooth controller/host on
# core 1. Espressif recommends separate cores for classic ESP32 coexistence;
# this prevents Wi-Fi reconnect state work from starving BLE GAP progress.
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y
CONFIG_BT_BLUEDROID_PINNED_TO_CORE_1=y

# Size optimization: -Os instead of -Og saves ~100-150KB
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# We only need STA mode, disable SoftAP (~30KB)
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n

# Cashu API traffic is low-bandwidth. Keeping the Wi-Fi RX fast path in flash
# saves ~17 KiB of IRAM needed by simultaneous BLE advertising on ESP32.
CONFIG_ESP_WIFI_RX_IRAM_OPT=n

# Disable IPv6 since mints are IPv4 (~20KB)
CONFIG_LWIP_IPV6=n

# Reduce max sockets (default 10 is overkill)
CONFIG_LWIP_MAX_SOCKETS=4

# This hardware variant has no I2C/NFC peripheral, so keep its ISR out of the
# ESP32's constrained IRAM.
CONFIG_I2C_MASTER_ISR_HANDLER_IN_IRAM=n

# Task telemetry for the console 'tasks' command (stack high-water marks)
CONFIG_FREERTOS_USE_TRACE_FACILITY=y

# No keypad/NFC path needs millisecond scheduling on this target. A 100 Hz
# tick is sufficient for the 40 ms button debounce and 1.6 s radio dwell while
# avoiding needless wakeups on battery.
CONFIG_FREERTOS_HZ=100

# Quiet production logging: default WARN at runtime, but INFO strings stay
# compiled in so the console 'log i <tag>' command can re-enable them.
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y

# Memory-constrained TLS. By default each HTTPS connection allocates two
# ~16 KB mbedTLS content buffers up front, which must each be contiguous.
# Once the heap is fragmented by cached mint keysets the swap-POST handshake
# can no longer get them and fails with "PK verify failed / signature
# verification failed". Dynamic buffers size the RX buffer to the actual TLS
# record and free the CA bundle + SSL config after the handshake, cutting the
# peak contiguous demand dramatically.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y

# One-shot HTTP clients deliberately retain no cross-request TLS state. Drop
# unused client/server ticket code and avoid its saved-session allocations.
# CONFIG_ESP_TLS_CLIENT_SESSION_TICKETS is not set
# CONFIG_MBEDTLS_CLIENT_SSL_SESSION_TICKETS is not set
# CONFIG_MBEDTLS_SERVER_SSL_SESSION_TICKETS is not set

# Match the S3 UART bridge and keep native USB console disabled.
CONFIG_ESP_CONSOLE_UART_TX_GPIO=43
CONFIG_ESP_CONSOLE_UART_RX_GPIO=44
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=n
CONFIG_SPIRAM=n

# ESP32-S3 controller settings (classic ESP32 uses BTDM_CTRL names).
CONFIG_BT_CTRL_BLE_MAX_ACT=1
CONFIG_BT_CTRL_PINNED_TO_CORE_1=y
